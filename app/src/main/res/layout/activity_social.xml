<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <TextView
        android:id="@+id/tvSocialTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Partager ce Site"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/textColorPrimary"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSocialDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Partagez ce site avec vos amis sur les réseaux sociaux !"
        android:textSize="16sp"
        android:textColor="@color/textColorSecondary"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvSocialTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/llShareButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvSocialDesc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnShareFacebook"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
           android:src="@drawable/ic_facebook"
        android:contentDescription="Partager sur Facebook" />

        <ImageButton
            android:id="@+id/btnShareTwitter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_twitter"
        android:contentDescription="Partager sur Twitter" />

        <ImageButton
            android:id="@+id/btnShareInstagram"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_instagram"
        android:contentDescription="Partager sur Instagram" />

        <ImageButton
            android:id="@+id/btnShareWhatsApp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
           android:src="@drawable/ic_whatsapp"
        android:contentDescription="Partager sur WhatsApp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
