<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clCategories"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    tools:context=".activities.CategoriesActivity">

    <TextView
        android:id="@+id/tvCategoriesHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select a Category"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/textColorPrimary"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/llCategories"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvCategoriesHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/llRestaurant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivRestaurant"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="@string/restaurant"
                android:src="@drawable/ic_restaurant" />

            <TextView
                android:id="@+id/tvRestaurant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Restaurants"
                android:textColor="@color/textColorPrimary"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llHotel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:clickable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivHotel"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_hotel"
                android:contentDescription="@string/hotel" />

            <TextView
                android:id="@+id/tvHotel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hotels"
                android:textSize="16sp"
                android:textColor="@color/textColorPrimary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Bloc de catégorie: Attractions -->
        <LinearLayout
            android:id="@+id/llAttraction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:clickable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivAttraction"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_attraction"
                android:contentDescription="@string/attraction" />

            <TextView
                android:id="@+id/tvAttraction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attractions"
                android:textSize="16sp"
                android:textColor="@color/textColorPrimary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llHospital"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:clickable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivHospital"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_hospital"
                android:contentDescription="@string/hospital" />

            <TextView
                android:id="@+id/tvHospital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hospitals"
                android:textSize="16sp"
                android:textColor="@color/textColorPrimary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llMosque"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:clickable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivMosque"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_mosque"
                android:contentDescription="@string/mosque" />

            <TextView
                android:id="@+id/tvMosque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mosques"
                android:textSize="16sp"
                android:textColor="@color/textColorPrimary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llStation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:clickable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivStation"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_station"
                android:contentDescription="@string/station" />

            <TextView
                android:id="@+id/tvStation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stations"
                android:textSize="16sp"
                android:textColor="@color/textColorPrimary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
