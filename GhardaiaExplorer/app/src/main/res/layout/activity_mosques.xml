<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clMosques"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    tools:context=".activities.MosquesActivity">

    <TextView
        android:id="@+id/tvMosquesHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mosques"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/textColorPrimary"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollViewMosques"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvMosquesHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/llMosqueList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardMosque1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ivMosque1"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_mosque" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="8dp">

                        <TextView
                            android:id="@+id/tvMosqueName1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Al Ghofran Mosque"
                            android:textSize="18sp"
                            android:textColor="@color/textColorPrimary"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:id="@+id/ivMap1"
                                android:layout_width="24dp"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:contentDescription="@string/open_map"
                                android:focusable="true"
                                android:onClick="openMap"
                                android:src="@drawable/ic_map" />
                            <TextView
                                android:id="@+id/tvHospitalAddress1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="FJWV+G54, N1, Ghardaia, Algeria"
                                android:textSize="14sp"
                                android:textColor="@color/textColorSecondary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardMosque2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ivMosque2"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_mosque" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="8dp">

                        <TextView
                            android:id="@+id/tvMosqueName2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Al Atique Mosque"
                            android:textSize="18sp"
                            android:textColor="@color/textColorPrimary"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:id="@+id/ivMap1"
                                android:layout_width="24dp"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:contentDescription="@string/open_map"
                                android:focusable="true"
                                android:onClick="openMap"
                                android:src="@drawable/ic_map" />
                            <TextView
                                android:id="@+id/tvHospitalAddress1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="FJWV+G54, N1, Ghardaia, Algeria"
                                android:textSize="14sp"
                                android:textColor="@color/textColorSecondary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardMosque3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ivMosque3"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_mosque" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="8dp">

                        <TextView
                            android:id="@+id/tvMosqueName3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Metlili Mosque"
                            android:textSize="18sp"
                            android:textColor="@color/textColorPrimary"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:id="@+id/ivMap1"
                                android:layout_width="24dp"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:contentDescription="@string/open_map"
                                android:focusable="true"
                                android:onClick="openMap"
                                android:src="@drawable/ic_map" />
                            <TextView
                                android:id="@+id/tvHospitalAddress1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="FJWV+G54, N1, Ghardaia, Algeria"
                                android:textSize="14sp"
                                android:textColor="@color/textColorSecondary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardMosque4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ivMosque4"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_mosque" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="8dp">

                        <TextView
                            android:id="@+id/tvMosqueName4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Taqwa Mosque"
                            android:textSize="18sp"
                            android:textColor="@color/textColorPrimary"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:id="@+id/ivMap1"
                                android:layout_width="24dp"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:contentDescription="@string/open_map"
                                android:focusable="true"
                                android:onClick="openMap"
                                android:src="@drawable/ic_map" />
                            <TextView
                                android:id="@+id/tvHospitalAddress1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="FJWV+G54, N1, Ghardaia, Algeria"
                                android:textSize="14sp"
                                android:textColor="@color/textColorSecondary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardMosque5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ivMosque5"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_mosque" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="8dp">

                        <TextView
                            android:id="@+id/tvMosqueName5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Badr Mosque"
                            android:textSize="18sp"
                            android:textColor="@color/textColorPrimary"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:id="@+id/ivMap1"
                                android:layout_width="24dp"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:contentDescription="@string/open_map"
                                android:focusable="true"
                                android:onClick="openMap"
                                android:src="@drawable/ic_map" />
                            <TextView
                                android:id="@+id/tvAddress1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="FJWV+G54, N1, Ghardaia, Algeria"
                                android:textSize="14sp"
                                android:textColor="@color/textColorSecondary" />
                        </LinearLayout>


                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
