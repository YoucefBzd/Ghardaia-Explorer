<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:animateLayoutChanges="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    tools:context=".activities.MainActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ghardaia Explorer"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/textColorPrimary"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <ImageView
        android:id="@+id/ivBanner"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ds"
        android:contentDescription="@string/app_banner"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />


    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="🧭 Discover Algeria Like Never Before!
Welcome to Ghardaia Explorer, your smart travel companion to explore the beauty and diversity of Algeria. Whether you're a passionate traveler, a curious local, or a casual explorer, our app provides instant access to reliable information, must-see destinations, custom itineraries, and practical tips to help you live truly authentic experiences.

✨ Key Features:

📍 Explore wilayas with detailed region profiles

🗺️ Interactive maps and guided routes

🕌 Cultural, historical and architectural insights

🍽️ Recommendations for local food, accommodations and attractions

🧳 Travel tips, weather updates and local customs

From the southern oases to the northern mountains, experience Algeria with a guide right in your pocket.

📲 Download now and start your adventure!

"
        android:textSize="16sp"
        android:textColor="@color/textColorSecondary"
        android:gravity="center"
        android:padding="16dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:onClick="toggleDescription"
        app:layout_constraintTop_toBottomOf="@id/ivBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <LinearLayout
        android:id="@+id/llTeam"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <TextView
            android:id="@+id/tvMember1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Developed by: Youcef Bouzid"
            android:textSize="14sp"
            android:textColor="@color/textColorSecondary"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="showMemberToast" />


        <TextView
            android:id="@+id/tvMember2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Haroune Dridi"
            android:textSize="14sp"
            android:textColor="@color/textColorSecondary"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="showMemberToast" />


        <TextView
            android:id="@+id/tvMember3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ikram "
            android:textSize="14sp"
            android:textColor="@color/textColorSecondary"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="showMemberToast" />
    </LinearLayout>


    <Button
        android:id="@+id/btnWilaya"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Discover the Wilaya"
        android:backgroundTint="@color/primaryColor"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/llTeam"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp" />


    <Button
        android:id="@+id/btnCategories"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="View Categories"
        android:backgroundTint="@color/primaryColor"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/btnWilaya"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp" />


    <Button
        android:id="@+id/btnMap"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Interactive Map"
        android:backgroundTint="@color/primaryColor"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/btnCategories"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
